{
  "name": "CardPurchase",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome/descri\u00e7\u00e3o da compra"
    },
    "totalAmount": {
      "type": "number",
      "description": "Valor total da compra"
    },
    "installmentsTotal": {
      "type": "number",
      "description": "N\u00famero total de parcelas"
    },
    "purchaseDate": {
      "type": "string",
      "format": "date",
      "description": "Data da compra (cria\u00e7\u00e3o no app)"
    },
    "firstPaymentDate": {
      "type": "string",
      "format": "date",
      "description": "Data do primeiro pagamento"
    },
    "creditCardId": {
      "type": "string",
      "description": "ID do cart\u00e3o"
    },
    "categoryId": {
      "type": "string",
      "description": "ID da categoria"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de exclus\u00e3o (soft delete)"
    }
  },
  "required": [
    "totalAmount",
    "installmentsTotal",
    "purchaseDate",
    "firstPaymentDate",
    "creditCardId"
  ]
}