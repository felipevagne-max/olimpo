    },
    "sourceId": {
      "type": "string",
      "description": "ID da fonte"
    },
    "amount": {
      "type": "number",
      "description": "Quantidade de XP (positivo ou negativo)"
    },
    "note": {
      "type": "string",
      "description": "Nota/descri\u00e7\u00e3o"
    }
  },
