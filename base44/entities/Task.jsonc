{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da tarefa (YYYY-MM-DD)"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "description": "Prazo final"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard",
        "epic"
      ],
      "default": "medium",
      "description": "Dificuldade da tarefa"
    },
    "isRecurring": {
      "type": "boolean",
      "default": false
    },
    "recurringDays": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dias de recorr\u00eancia"
    },
    "xpReward": {
      "type": "number",
      "default": 10
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "goalId": {
      "type": "string",
      "description": "ID da meta vinculada"
    },
    "projectId": {
      "type": "string",
      "description": "ID do projeto vinculado"
    },
    "rolledFromDate": {
      "type": "string",
      "format": "date",
      "description": "Data original se tarefa foi rolada"
    },
    "isOverdue": {
      "type": "boolean",
      "default": false,
      "description": "Se tarefa est\u00e1 atrasada"
    },
    "habitId": {
      "type": "string",
      "description": "ID do h\u00e1bito que gerou esta tarefa (se aplic\u00e1vel)"
    },
    "timeOfDay": {
      "type": "string",
      "description": "Hor\u00e1rio da tarefa (HH:mm)"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do dono do registro (usado para filtro multi-user)"
    }
  },
  "required": [
    "title",
    "date"
  ]
}